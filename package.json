{
  "name": "keystone-knowledge-risk-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Keystone — knowledge risk radar for Jira and Confluence, built entirely on Atlassian Forge and the Teamwork Graph API.",
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "test": "node --test test/*.test.js",
    "check": "npm run test && npm run build",
    "queries:print": "node scripts/register-queries.mjs",
    "queries:post": "node scripts/register-queries.mjs --post",
    "queries:probe": "node scripts/probe-query.mjs"
  },
  "dependencies": {
    "@forge/api": "^8.4.0",
    "@forge/bridge": "^6.0.0",
    "@forge/cli": "^14.2.0",
    "@forge/kvs": "^2.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "esbuild": "^0.25.0"
  },
  "engines": {
    "node": ">=22"
  }
}
